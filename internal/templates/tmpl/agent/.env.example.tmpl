# Environment contract for {{.AgentName}} ({{.ProjectName}}).
#
# The BASE IMAGE reads only the AGENT_* vars in section 1 (plus the
# TELEGRAM_CHAT_ID / AUTOMATION_MODEL entries in section 2). Everything in
# section 3 is SPEC-DEPENDENT: the base never reads those names itself;
# they reach the runtime only through agent/spec.json {env:NAME} refs and
# if_env guards. Copy this file to agent/.env (agentctl secrets init
# generates the gateway token too) and fill in real values — agent/.env
# is gitignored; values never reach git or logs.

# --- 1. Base image contract (read by container code) ---

# GitHub token for `gh auth login`, used only when spec features.gh_auth
# is true. Never logged; auth is re-established every boot.
#AGENT_GIT_TOKEN=

# Seconds a shutdown signal (SIGTERM/SIGINT — compose stop) waits for the
# gateway and its in-flight automations before their process group is
# force-killed. Keep the compose stop_grace_period (11m) above this.
#AGENT_SHUTDOWN_GRACE=600

# Destination for the automatic upgrade backup (default: /backups;
# compose.yml mounts the {{.ProjectName}}-agent-backups volume there so
# archives survive container replacement).
#AGENT_BACKUP_DIR=/backups

# Do NOT set OPENCLAW_HOME: the entrypoint pops it — the default
# (~/.openclaw) is correct.

# --- 2. Base image, automations delivery (read by the cron reconciler) ---
{{if .Telegram}}
# Telegram chat ID for automation delivery. When unset, cron jobs run
# without Telegram delivery.
#TELEGRAM_CHAT_ID=
{{end}}
# Fallback model for cron agent turns when the entrypoint does not pass
# --model. The entrypoint always passes spec automations.model, so this
# matters only for manual seed_automations.py runs.
#AUTOMATION_MODEL=

# --- 3. Spec-dependent (consumed via agent/spec.json {env:NAME} refs) ---

# Z.AI API key for the setup.auth_choice provider (GLM Coding Plan).
# REQUIRED at load when setup.auth_choice is zai-coding-*: the spec
# loader fails closed naming this var, and openclaw setup refuses to run
# without it (a missing key aborts the boot before any container work).
#ZAI_API_KEY=

# Gateway auth token. The gateway reads this env var natively (token
# auth arms whenever it is set); features.gateway_auth: true additionally
# writes the canonical gateway.auth.token reference pair into config.
# agentctl secrets init generates it automatically (crypto/rand, 64 hex).
#OPENCLAW_GATEWAY_TOKEN=
{{if .Telegram}}
# Telegram bot token for the telegram channel declared in spec.json.
#TELEGRAM_BOT_TOKEN=

# Comma-separated allowed Telegram user IDs (spec config entry
# channels.telegram.allowFrom with split_csv: true; the base splits,
# strips, and drops empties for you).
#TELEGRAM_ALLOWED_USERS=
{{end}}
# --- 4. Compose interpolation (host-side, never enters the container) ---

# Host port for the gateway publish line in compose.yml.
#AGENT_GATEWAY_PORT={{.GatewayPort}}
