#!/bin/sh
# Thin shim over agentctl — every target lives there.
# Install (agent-base is date-versioned, no semver tags for go install):
#   release binary:
#     curl -fsSL -o ~/bin/agentctl \
#       https://github.com/tankdonut/agent-base/releases/download/<tag>/agentctl-linux-<amd64|arm64>
#   from source (clone of tankdonut/agent-base):
#     go install ./agent-base/cmd/agentctl
exec agentctl "$@"
