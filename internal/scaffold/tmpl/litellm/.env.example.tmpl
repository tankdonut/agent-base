# LiteLLM proxy secrets — copy to litellm/.env (agentctl secrets init
# does it, generating the master key). This file's env enters ONLY the
# litellm service; the agent container never sees it. Provider keys live
# here and nowhere else.

# Proxy master key: authenticates /v1 callers (the agent's
# LITELLM_API_KEY in agent/.env must carry the same value — secrets init
# mirrors it; secrets check enforces the match). Rotating means editing
# BOTH files, then `agentctl restart`.
#LITELLM_MASTER_KEY=

# Provider API keys — add one per provider your models need, then
# reference them from config.yaml as os.environ/NAME. Values never
# reach git or logs.
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#ZAI_API_KEY=
