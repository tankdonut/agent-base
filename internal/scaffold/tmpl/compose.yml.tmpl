# {{.ProjectName}} agent service (production compose file). The image is
# the thin project Dockerfile (agent/Dockerfile) over
# ghcr.io/tankdonut/agent-base per docs/standard-agent.md Quick start.
#
# The hardening below is ACTIVE, matching the agent-base production
# baseline (agent-base templates/compose.prod.agent.yml;
# docs/standard-agent.md "Deployment hardening"): named volumes cover
# every writable path the base needs ({data} at /home/node/.openclaw,
# plus /backups for verified upgrade archives), so the container root
# filesystem stays immutable under read_only.

# Pinned compose project name: every generated resource (containers,
# volumes, the agent-net network) is prefixed with it, so the stack is
# immune to directory renames and cannot collide with another agent
# scaffolded from a different project on the same host. Real volume
# names are <project>_agent-data / <project>_agent-backups.
name: {{.ComposeProject}}

services:
  agent:
    build:
      context: .
      dockerfile: agent/Dockerfile
    restart: unless-stopped
    # Graceful shutdown: keep the engine stop timeout above
    # AGENT_SHUTDOWN_GRACE (600s default) or the engine SIGKILLs the
    # gateway process group mid-drain.
    stop_grace_period: 11m
    # Hardening baseline: no privilege escalation, no Linux
    # capabilities, and a read-only root filesystem (writable paths are
    # the named volumes plus tmpfs /tmp).
    security_opt:
      - no-new-privileges:true
    cap_drop: [ALL]
    read_only: true
    tmpfs:
      - /tmp
    env_file:
      - agent/.env
    # Two networks: agent-net stays dedicated to the gateway port (a
    # bearer-auth-only surface — no unrelated sibling shares its L2; a
    # host-process reverse proxy reaches it via the 127.0.0.1 bind
    # below). model-net carries exactly the agent and its LiteLLM proxy:
    # the proxy CAN reach the gateway over it — accepted, the gateway is
    # token-gated on every interface; keeping the pair on their own
    # network is what keeps every other sibling off the gateway L2.
    networks:
      - agent-net
      - model-net
    # Boot ordering only (service_started): the gateway serves healthz
    # before the proxy settles; a broken proxy surfaces as model-call
    # errors + its own healthcheck, not as a dead agent.
    depends_on:
      - litellm
    volumes:
      - agent-data:/home/node/.openclaw
      # Verified upgrade backups land here before any image-version
      # delta mutates a warm volume.
      - agent-backups:/backups
    # Loopback-only bind; remote access goes through a TLS-terminating
    # reverse proxy (agent-base docs/deployment.md). AGENT_GATEWAY_PORT
    # is host-side compose interpolation and never enters the container.
    ports:
      - "127.0.0.1:${AGENT_GATEWAY_PORT:-{{.GatewayPort}}}:18789"
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://localhost:18789/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
      interval: 30s
      timeout: 10s
      retries: 3
      # First boot runs setup + reconcile + seed before the gateway
      # starts; upgrade boots add a verified backup. Matches the image
      # HEALTHCHECK.
      start_period: 300s
    # Resource ceiling: the pids limit blunts fork runaway from
    # agent-spawned processes; keep the sum of service limits below
    # host RAM.
    deploy:
      resources:
        limits:
          cpus: "2.0"
          memory: 2g
          pids: 512
    # Rotate container logs host-side; json-file keeps `agentctl logs`
    # working. Values are strings, not numbers.
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "5"
    # Rootless podman: if SELinux MCS denials hit the named volumes, add
    # `label=disable` under security_opt (rationale in agent-base
    # templates/compose.agent.yml).

  # Model/provider home: EVERY provider API key lives only in
  # litellm/.env (env_file below) — the agent container never sees them
  # and holds only the proxy key (LITELLM_API_KEY in agent/.env, mirrored
  # from LITELLM_MASTER_KEY by `agentctl secrets init`). DB-less mode:
  # the master key is the whole auth surface (no virtual keys/budgets —
  # those need a database). Version tag is pinned; Renovate
  # (renovate.json) bumps + digest-pins it.
  litellm:
    image: ghcr.io/berriai/litellm:v1.100.0@sha256:c8756e7b9a61fe45df2ccb5b781d388c3b2f3a21ef9e4956630caef20f9f03aa
    command: ["--config", "/app/proxy_server_config.yaml", "--port", "4000"]
    restart: unless-stopped
    env_file:
      - litellm/.env
    # Read-only config mount; the Z suffix relabels for rootless-podman
    # SELinux hosts (spike-verified; a no-op elsewhere). The proxy
    # config carries no secrets — keys arrive via env indirection
    # (os.environ/NAME).
    volumes:
      - ./litellm/config.yaml:/app/proxy_server_config.yaml:ro,Z
    networks:
      - model-net
    # No published ports: the proxy is agent-reachable only (model-net),
    # never host-reachable.
    healthcheck:
      # The image ships no curl; its venv python3 serves the probe.
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:4000/health/liveliness', timeout=5)"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    security_opt:
      - no-new-privileges:true
    cap_drop: [ALL]
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: 1g

networks:
  agent-net: {}
  model-net: {}

volumes:
  agent-data:
  agent-backups:
