# Environment contract for a standard-agent project.
#
# The BASE IMAGE reads only the AGENT_* vars in section 1 (plus the
# TELEGRAM_CHAT_ID / AUTOMATION_MODEL entries in section 2). Everything in
# section 3 is SPEC-DEPENDENT: the base never reads those names itself;
# they reach the runtime only through your spec.json's {env:NAME} refs,
# if_env guards, and split_csv values. Copy the vars your spec actually
# references; delete the rest.

# --- 1. Base image contract (read by container code) ---

# Override the spec.json location (default: /opt/agent/spec.json; tests and
# fixtures use this).
#AGENT_SPEC_PATH=/opt/agent/spec.json

# "0" skips config/MCP/plugin reconciliation for operators who manage
# openclaw.json manually (default: 1).
#AGENT_MANAGE_CONFIG=1

# "1" skips CONTENT SEEDING ONLY; config/MCP/plugin reconciliation still
# runs. Dev overlays set this and bind-mount the content over /opt/seed/*.
#AGENT_SKIP_SEED=0

# "0" skips the post-startup memory reindex (default: 1).
#AGENT_MEMORY_REINDEX=1

# GitHub token for `gh auth login`, used only when spec features.gh_auth
# is true. Never logged; auth is re-established every boot.
#AGENT_GIT_TOKEN=

# Override the automations directory (default: /opt/agent/automations).
#AGENT_AUTOMATIONS_DIR=/opt/agent/automations

# --- 2. Base image, automations delivery (read by the cron reconciler) ---

# Telegram chat ID for automation delivery. When unset, cron jobs run
# without Telegram delivery. Standardized name, see docs/standard-agent.md.
#TELEGRAM_CHAT_ID=

# Fallback model for cron agent turns when the entrypoint does not pass
# --model. The entrypoint always passes spec automations.model, so this
# matters only for manual seed_automations.py runs.
#AUTOMATION_MODEL=

# Do NOT set OPENCLAW_HOME: the entrypoint pops it. OpenClaw treats it as
# a home dir and appends .openclaw/ within it (double-nesting); the
# default (~/.openclaw) is correct.

# --- 3. Spec-dependent (consumed via spec.json {env:...} refs) ---
# The names below are examples; keep whatever YOUR spec.json references.

# Gateway auth token (spec config entry gateway.token, guarded by if_env).
#OPENCLAW_GATEWAY_TOKEN=

# Z.AI API key for the setup.auth_choice provider (GLM Coding Plan).
# REQUIRED at load when setup.auth_choice is zai-coding-*: the spec loader
# fails closed naming this var, and openclaw setup refuses to run without
# it (a missing key aborts the boot before any container work).
#ZAI_API_KEY=

# Telegram bot token (spec config entry telegram.botToken).
#TELEGRAM_BOT_TOKEN=

# Comma-separated allowed Telegram user IDs (spec config entry with
# split_csv: true; the base splits, strips, and drops empties for you).
#TELEGRAM_ALLOWED_USERS=

# Telegram forum topic IDs per automation (automation header topic-env).
#TELEGRAM_TOPIC_MORNING=

# Provider API keys templated into remote MCP URLs and headers.
#ALPHAVANTAGE_API_KEY=
#LUNARCRUSH_API_KEY=

# --- 4. Compose interpolation (host-side, never enters the container) ---

# Host port for the gateway publish line in compose.agent.yml.
#AGENT_GATEWAY_PORT=18789
