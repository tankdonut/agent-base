{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "allow",
      "**": "allow",
      ".omo/**": "allow",
      "**/.omo/**": "allow",
      ".git/**": "deny",
      "**/.git/**": "deny",
      ".codegraph/**": "deny",
      ".env": "ask",
      ".env.*": "ask",
      "**/.env": "ask",
      "**/.env.*": "ask"
    },
    "bash": {
      "*": "ask",

      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "fd *": "allow",
      "wc *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "tree *": "allow",
      "diff *": "allow",
      "which *": "allow",
      "command -v *": "allow",
      "date": "allow",
      "date *": "allow",
      "uname *": "allow",
      "echo *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",

      "./make.sh": "allow",
      "./make.sh *": "allow",
      "scripts/smoke.sh*": "allow",
      "sh scripts/smoke.sh*": "allow",
      "bash scripts/smoke.sh*": "allow",

      "python3 --version": "allow",
      "python3 -V": "allow",
      "python3 -m unittest*": "allow",
      "python3 -m json.tool*": "allow",
      "python -m unittest*": "allow",
      "pre-commit": "allow",
      "pre-commit *": "allow",
      "ruff *": "allow",
      "hadolint *": "allow",
      "markdownlint-cli2 *": "allow",

      "git *": "allow",
      "git config *": "ask",
      "git config --get*": "allow",
      "git push*": "ask",
      "git reset*": "ask",
      "git clean*": "ask",
      "git filter-branch*": "ask",

      "gh pr view*": "allow",
      "gh pr list*": "allow",
      "gh pr diff*": "allow",
      "gh pr checks*": "allow",
      "gh run list*": "allow",
      "gh run view*": "allow",
      "gh repo view*": "allow",

      "podman build*": "allow",
      "podman images*": "allow",
      "podman image ls*": "allow",
      "podman ps*": "allow",
      "podman version*": "allow",
      "podman run --rm *": "allow",
      "docker build*": "allow",
      "docker images*": "allow",
      "docker image ls*": "allow",
      "docker ps*": "allow",
      "docker version*": "allow",
      "docker run --rm *": "allow",

      "./make.sh push*": "ask"
    }
  }
}
