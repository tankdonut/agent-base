{
  "specVersion": 1,
  "agent": {
    "name": "contract-canary"
  },
  "setup": {
    "auth_choice": "zai-coding-global"
  },
  "model": {
    "fallback": "zai/glm-5.3-flash"
  },
  "automations": {
    "model": "zai/glm-5.3-flash"
  },
  "config": [
    {
      "path": "tools.profile",
      "value": "coding",
      "strict": true
    }
  ],
  "channels": [
    {
      "type": "telegram",
      "use_env": true
    }
  ],
  "mcp_servers": [
    {
      "name": "contract-remote",
      "url": "https://mcp.invalid/mcp",
      "headers": {
        "Authorization": "Bearer {env:CONTRACT_REMOTE_TOKEN}"
      },
      "timeout": 11,
      "transport": "streamable-http"
    },
    {
      "name": "contract-local",
      "command": "/bin/true",
      "args": ["canary-arg"],
      "no_probe": true
    }
  ]
}
